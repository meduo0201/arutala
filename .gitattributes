# Normalize line endings: LF in repo, CRLF in working tree on Windows.
# Cegah CRLF warnings di `git add` dari mixed-OS contributors / editors.
* text=auto eol=lf

# Source & config — explicit LF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
.env*       text eol=lf
.gitignore  text eol=lf

# Lock files — LF, no diff in PRs
pnpm-lock.yaml   text eol=lf -diff
package-lock.json text eol=lf -diff

# Shell scripts — LF (would break otherwise on Linux)
*.sh        text eol=lf

# Windows scripts — CRLF (would break otherwise on Windows)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
